{
  "name": "tossinvest-mcp",
  "version": "2.0.0",
  "description": "토스증권 Open API MCP 서버",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tossinvest-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "es-toolkit": "1.53.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.72.1"
  },
  "packageManager": "pnpm@10.28.0"
}
